{
  "name": "merida",
  "private": true,
  "version": "0.1.0",
  "description": "Merida: la consola web local de la familia Kyora (tareas, música y chat sobre Supabase).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:live": "node scripts/check-live.ts",
    "build:usb": "node scripts/build-usb.ts",
    "usb": "cmd /c \"usb\\Abrir Merida.bat\""
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
